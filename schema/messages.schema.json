{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splash.invalid/schema/messages.schema.json",
  "title": "Splash agent message",
  "description": "One NDJSON line / one WebSocket text frame sent by an agent to the backend. Field names for game data must be verified against the plugin header (rF2State.h / rF2data.cs).",
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/scoring"
    },
    {
      "$ref": "#/$defs/telemetry"
    },
    {
      "$ref": "#/$defs/lap"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/command_result"
    }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "required": [
        "v",
        "type",
        "agent_id",
        "role",
        "session_id",
        "seq",
        "et",
        "payload"
      ],
      "properties": {
        "v": {
          "const": 1,
          "description": "Wire format version."
        },
        "type": {
          "enum": [
            "hello",
            "scoring",
            "telemetry",
            "lap",
            "event",
            "command_result"
          ]
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable id of the agent installation."
        },
        "role": {
          "enum": [
            "driver",
            "spotter"
          ]
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifies the game session; changes on session restart."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Sequence number of durable messages (hello is 0, then lap and event count up from 1), per agent and session, acknowledged by the backend. Live samples (scoring, telemetry) are not sequenced: they carry the last durable seq."
        },
        "et": {
          "type": "number",
          "minimum": 0,
          "description": "Game elapsed time in seconds. Time base for dedup between agents; never wall clock."
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "hello": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "properties": {
            "type": {
              "const": "hello"
            },
            "payload": {
              "type": "object",
              "required": [
                "agent_version"
              ],
              "properties": {
                "agent_version": {
                  "type": "string"
                },
                "resume_from_seq": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "First seq the agent will (re)send."
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "scoring": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "properties": {
            "type": {
              "const": "scoring"
            },
            "payload": {
              "type": "object",
              "required": [
                "track",
                "session_type",
                "end_et",
                "vehicles"
              ],
              "properties": {
                "track": {
                  "type": "string"
                },
                "track_length": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Length of one lap in metres (mLapDist of the scoring info)."
                },
                "session_type": {
                  "type": "string"
                },
                "end_et": {
                  "type": "number",
                  "description": "Session end in game elapsed time (seconds)."
                },
                "game_phase": {
                  "type": "integer"
                },
                "yellow_state": {
                  "type": "integer",
                  "description": "Raw mYellowFlagState; applies to full-course yellow only (0 none, 1 pending, 2 pits closed, 3 pit lead lap, 4 pits open, 5 last lap, 6 resume). FCY is derived in the backend."
                },
                "weather": {
                  "type": "object",
                  "properties": {
                    "ambient_temp": {
                      "type": "number"
                    },
                    "track_temp": {
                      "type": "number"
                    },
                    "rain": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "wetness": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Average wetness on the racing line (mAvgPathWetness)."
                    },
                    "dark_cloud": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Cloud darkness (mDarkCloud)."
                    }
                  },
                  "additionalProperties": false
                },
                "vehicles": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/scoringVehicle"
                  }
                },
                "sector_flags": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "integer"
                  },
                  "description": "Raw mSectorFlag: local yellow per sector."
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "scoringVehicle": {
      "type": "object",
      "required": [
        "car_id",
        "vehicle_name",
        "driver",
        "vehicle_class",
        "place",
        "laps"
      ],
      "properties": {
        "car_id": {
          "type": "integer",
          "description": "Slot id (mID) within the session; can be reused after someone leaves."
        },
        "driver": {
          "type": "string"
        },
        "vehicle_class": {
          "type": "string"
        },
        "is_player": {
          "type": "boolean"
        },
        "place": {
          "type": "integer",
          "minimum": 1
        },
        "laps": {
          "type": "integer",
          "minimum": 0
        },
        "last_lap": {
          "type": [
            "number",
            "null"
          ]
        },
        "best_lap": {
          "type": [
            "number",
            "null"
          ]
        },
        "last_s1": {
          "type": [
            "number",
            "null"
          ],
          "description": "Sector 1 duration in seconds."
        },
        "last_s2": {
          "type": [
            "number",
            "null"
          ],
          "description": "Sector 2 duration in seconds. The plugin reports S1+S2 cumulative (mLastSector2); the agent subtracts S1."
        },
        "in_pits": {
          "type": "boolean"
        },
        "lap_dist": {
          "type": "number",
          "minimum": 0,
          "description": "Distance along the lap in metres (mLapDist)."
        },
        "x": {
          "type": "number",
          "description": "World position x in metres (mPos)."
        },
        "z": {
          "type": "number",
          "description": "World position z in metres (mPos)."
        },
        "pit_state": {
          "type": "integer"
        },
        "num_pitstops": {
          "type": "integer",
          "minimum": 0
        },
        "time_behind_next": {
          "type": [
            "number",
            "null"
          ]
        },
        "laps_behind_leader": {
          "type": "integer",
          "minimum": 0
        },
        "vehicle_name": {
          "type": "string",
          "minLength": 1,
          "description": "Vehicle name. Together with car_id it identifies a car, because the plugin may reuse slot ids in multiplayer."
        },
        "control": {
          "enum": [
            -1,
            0,
            1,
            2
          ],
          "description": "mControl: -1 nobody, 0 local player, 1 local AI, 2 remote."
        },
        "fuel": {
          "type": "number",
          "minimum": 0,
          "description": "Fuel in litres, from the telemetry slot of the car."
        },
        "fuel_capacity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Tank capacity in litres."
        },
        "wear": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "Wear value of each tyre (fl, fr, rl, rr) as the game reports it; 1 is new."
        },
        "penalties": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of penalties of the car."
        },
        "path_lateral": {
          "type": "number",
          "description": "Lateral position of the car relative to the track centre line in metres."
        },
        "track_edge": {
          "type": "number",
          "description": "Distance from the centre line to the track edge at the position of the car in metres."
        }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "properties": {
            "type": {
              "const": "telemetry"
            },
            "payload": {
              "type": "object",
              "required": [
                "car_id",
                "vehicle_name",
                "lap",
                "fuel",
                "fuel_capacity",
                "wear"
              ],
              "properties": {
                "car_id": {
                  "type": "integer"
                },
                "lap": {
                  "type": "integer",
                  "minimum": 0
                },
                "lap_dist": {
                  "type": "number",
                  "minimum": 0
                },
                "fuel": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Litres."
                },
                "fuel_capacity": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "wear": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  },
                  "description": "Tyre wear fl, fr, rl, rr as delivered by the plugin (mWear): 0.0-1.0, fraction of maximum. Direction (1.0 new or worn) not stated in the header; verify in game."
                },
                "damage": {
                  "type": "number",
                  "minimum": 0
                },
                "vehicle_name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Vehicle name. Together with car_id it identifies a car, because the plugin may reuse slot ids in multiplayer."
                },
                "tyre_carcass_temp": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  },
                  "description": "Carcass temperature fl, fr, rl, rr in degrees Celsius (the plugin delivers Kelvin)."
                },
                "tyre_surface_temp": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    },
                    "description": "left, centre, right"
                  },
                  "description": "Surface temperature per wheel (fl, fr, rl, rr) and position (left, centre, right of the tread, not inside/outside) in degrees Celsius."
                },
                "tyre_inner_temp": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    },
                    "description": "left, centre, right"
                  },
                  "description": "Inner rubber layer temperature per wheel and position in degrees Celsius."
                },
                "tyre_pressure": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  },
                  "description": "Tyre pressure fl, fr, rl, rr in kPa."
                },
                "brake_temp": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  },
                  "description": "Brake disc temperature fl, fr, rl, rr in degrees Celsius."
                },
                "engine_water_temp": {
                  "type": "number",
                  "description": "Engine water temperature in degrees Celsius."
                },
                "engine_oil_temp": {
                  "type": "number",
                  "description": "Engine oil temperature in degrees Celsius."
                },
                "compound_front": {
                  "type": "string",
                  "description": "Name of the front tyre compound."
                },
                "compound_rear": {
                  "type": "string",
                  "description": "Name of the rear tyre compound."
                },
                "pit_menu": {
                  "type": "object",
                  "description": "The row of the pit menu that is selected in the game.",
                  "required": [
                    "category",
                    "choice",
                    "choice_index",
                    "choices"
                  ],
                  "properties": {
                    "category": {
                      "type": "string",
                      "description": "Name of the menu row, e.g. FUEL:."
                    },
                    "choice": {
                      "type": "string",
                      "description": "Selected value of the row as the game shows it."
                    },
                    "choice_index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "choices": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "additionalProperties": false
                },
                "dent_max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2,
                  "description": "Largest dent severity over the body areas: 0 none, 1 some, 2 heavy."
                },
                "overheating": {
                  "type": "boolean",
                  "description": "The engine is overheating."
                },
                "detached": {
                  "type": "boolean",
                  "description": "A body part has come off."
                },
                "brake": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Unfiltered brake pedal position."
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "lap": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "properties": {
            "type": {
              "const": "lap"
            },
            "payload": {
              "type": "object",
              "required": [
                "car_id",
                "vehicle_name",
                "lap",
                "lap_time",
                "in_lap",
                "out_lap"
              ],
              "properties": {
                "car_id": {
                  "type": "integer"
                },
                "lap": {
                  "type": "integer",
                  "minimum": 1
                },
                "driver": {
                  "type": "string"
                },
                "lap_time": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "s1": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "s2": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Sector 2 duration in seconds (not cumulative)."
                },
                "s3": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Sector 3 duration in seconds: lap time minus S1 minus S2."
                },
                "fuel_start": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Empty for opponents."
                },
                "fuel_end": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "tyre_age": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "wear": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  }
                },
                "fcy": {
                  "type": "boolean"
                },
                "in_lap": {
                  "type": "boolean"
                },
                "out_lap": {
                  "type": "boolean"
                },
                "vehicle_name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Vehicle name. Together with car_id it identifies a car, because the plugin may reuse slot ids in multiplayer."
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "event": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "properties": {
            "type": {
              "const": "event"
            },
            "payload": {
              "type": "object",
              "required": [
                "kind",
                "vehicle_name",
                "car_id"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "pit_entry",
                    "pit_exit",
                    "driver_swap",
                    "fcy_start",
                    "fcy_end"
                  ]
                },
                "car_id": {
                  "type": "integer"
                },
                "driver": {
                  "type": "string"
                },
                "fuel_added": {
                  "type": "number",
                  "minimum": 0
                },
                "tyres_changed": {
                  "type": "boolean"
                },
                "vehicle_name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Vehicle name. Together with car_id it identifies a car, because the plugin may reuse slot ids in multiplayer."
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "ack": {
      "title": "Backend to agent acknowledgement",
      "type": "object",
      "required": [
        "type",
        "seq"
      ],
      "properties": {
        "type": {
          "const": "ack"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Highest seq stored by the backend; the agent may drop everything up to it from its send queue."
        }
      },
      "additionalProperties": false
    },
    "command_result": {
      "title": "Result of a command",
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "properties": {
            "type": {
              "const": "command_result"
            },
            "payload": {
              "type": "object",
              "required": [
                "id",
                "ok",
                "message"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Id of the command this answers."
                },
                "ok": {
                  "type": "boolean"
                },
                "message": {
                  "type": "string",
                  "description": "ok, or why the command failed."
                },
                "applied": {
                  "type": "array",
                  "description": "Pit menu rows that were set before the command ended.",
                  "items": {
                    "type": "object",
                    "required": [
                      "category",
                      "choice"
                    ],
                    "properties": {
                      "category": {
                        "type": "string"
                      },
                      "choice": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "command": {
      "title": "Backend to agent command",
      "description": "Asks the driver agent to set rows of the pit menu (kind pit_menu, the default) or to toggle the pit request (kind pit_request).",
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "command"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "category",
              "choice"
            ],
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1,
                "description": "Pit menu row, e.g. FUEL: or TIRES:."
              },
              "choice": {
                "type": "string",
                "minLength": 1,
                "description": "max, min, a number (litres) or a text the choice contains (e.g. Medium)."
              }
            },
            "additionalProperties": false
          }
        },
        "kind": {
          "enum": [
            "pit_menu",
            "pit_request"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
